# ─── RAGbot — Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in all values before running.
# Never commit .env to version control.

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use — llama3-8b-8192 is fast and free-tier friendly
GROQ_MODEL=llama3-8b-8192

# ── Google Sheets (lead storage) ───────────────────────────────────────────────
# Path to your downloaded service-account JSON key file
GOOGLE_CREDENTIALS_PATH=google-credentials.json

# Exact name of the Google Sheet (must be shared with the service account email)
GOOGLE_SHEET_NAME=RAG Chatbot Leads

# ── Email notifications (Gmail) ────────────────────────────────────────────────
# Gmail address used to SEND lead notifications
EMAIL_SENDER=yourbot@gmail.com

# Gmail App Password (NOT your regular password — generate at myaccount.google.com/apppasswords)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Address that receives lead notification emails
EMAIL_RECIPIENT=you@yourdomain.com

# ── Upload & RAG settings ─────────────────────────────────────────────────────
# Maximum PDF upload size in megabytes
MAX_FILE_SIZE_MB=10

# LangChain text splitter settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Number of top chunks to retrieve per query
TOP_K_RESULTS=3

# ── Server ────────────────────────────────────────────────────────────────────
# Allowed CORS origin for your frontend
# Local dev: http://localhost:3000 or http://127.0.0.1:5500
# Production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000

# Environment label — set to "production" on Render
ENV=development
